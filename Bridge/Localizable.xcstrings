    "%lld of %@: %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %@: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@中有 %1$lld 天：%3$@。"
          }
        }
      }
    },
    "%lld per day": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld por día"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天 %lld 次"
          }
        }
      }
    },
    "(%@. Logging started on %@, so earlier days are not counted.)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(%@. El registro comenzó el %@, por lo que los días anteriores no se cuentan.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（%@。从 %@ 开始记录，因此此前的日子不计算在内。）"
          }
        }
      }
    },
    "(The last %lld full days, not including today.)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(Los últimos %lld días completos, sin contar hoy.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（最近 %lld 个完整日，不含今天。）"
          }
        }
      }
    },
    "- %@ %@: %lld per day": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "- %@ %@: %lld por día"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "- %@ %@：每天 %lld 次"
          }
        }
      }
    },
    "- %@: %lld of %lld (%@)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "- %@: %lld de %lld (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "- %@：%lld / %lld（%@）"
          }
        }
      }
    },
    "0 is no pain, 10 is the worst. Days without a dose have no point.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0 es sin dolor y 10 es el peor. Los días sin dosis no tienen punto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0 表示不痛，10 表示最痛。没有用药记录的日子没有点。"
          }
        }
      }
    },
    "0 is no pain, 10 is the worst. Each point is a week's average, and weeks without a dose have no point.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0 es sin dolor y 10 es el peor. Cada punto es el promedio de una semana, y las semanas sin dosis no tienen punto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0 表示不痛，10 表示最痛。每个点是一周的平均值，没有用药记录的周没有点。"
          }
        }
      }
    },
    "650-493-5000, ext. 60050": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "650-493-5000, ext. 60050"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "650-493-5000，分机 60050"
          }
        }
      }
    },
    "Add Plan": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregar plan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加计划"
          }
        }
      }
    },
    "Add each medication your prescriber gave you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega cada medicamento que te recetó tu profesional de salud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加处方医生为你开的每一种药物。"
          }
        }
      }
    },
    "Addiction and substance abuse care": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atención para adicciones y abuso de sustancias"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成瘾和物质滥用护理"
          }
        }
      }
    },
    "Adds VA Palo Alto Health Care System resources below.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega abajo los recursos del VA Palo Alto Health Care System."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方添加 VA Palo Alto Health Care System 的资源。"
          }
        }
      }
    },
    "All of these are muted on purpose, and each stays easy to read in light and dark mode.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos son tonos suaves a propósito, y cada uno se lee con facilidad en modo claro y oscuro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些颜色都刻意选得柔和，并且在浅色和深色模式下都易于阅读。"
          }
        }
      }
    },
    "Also logged, but not in my plan: %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También registradas, pero que no están en mi plan: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另外记录了不在我的计划中的用药：%@。"
