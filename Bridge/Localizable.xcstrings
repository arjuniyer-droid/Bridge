    "Pain was recorded when each dose was logged, so a day with no doses has no pain score.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dolor se registró al anotar cada dosis, por lo que un día sin dosis no tiene puntuación de dolor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "疼痛评分是在记录每次用药时一并记录的，因此没有用药记录的日子就没有疼痛评分。"
          }
        }
      }
    },
