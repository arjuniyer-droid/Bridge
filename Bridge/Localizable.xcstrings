{
  "sourceLanguage": "en",
  "strings": {
    "\"Match my iPhone\" follows Settings > Accessibility > Display & Text Size on your phone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Igual que mi iPhone» sigue Ajustes > Accesibilidad > Pantalla y tamaño del texto en tu teléfono."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“跟随我的 iPhone”会遵循手机上“设置 > 辅助功能 > 显示与文字大小”中的设置。"
          }
        }
      }
    },
    "%@ in the last %lld days": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en los últimos %lld días"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 %2$lld 天共 %1$@"
          }
        }
      }
    },
    "%@ over %lld days": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en %lld días"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 天共 %1$@"
          }
        }
      }
    },
