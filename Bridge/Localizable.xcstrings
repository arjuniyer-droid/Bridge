    "Bridge does not give medical advice. Your prescriber is the only authority.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge no ofrece consejos médicos. Quien te receta es la única autoridad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge 不提供医疗建议。你的处方医生才是唯一权威。"
          }
        }
      }
    },
    "Calls the main number, then pauses and dials the extension.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llama al número principal, hace una pausa y marca la extensión."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先拨打总机号码，稍作停顿后再拨分机号。"
          }
        }
      }
    },
